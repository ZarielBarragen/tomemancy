{
  "format_version": "1.16.100",
  "minecraft:item": {
    "description": {

      "identifier": "tome:fire_ward_scroll",
      "category": "Items"
    },
    "components": {
      "minecraft:creative_category": {
        "parent": "itemGroup.name.scrolls_3"
      },
      "minecraft:max_stack_size": 16,
      "minecraft:foil": false,
      "minecraft:hand_equipped": false,
      "minecraft:icon":{
         "texture":"fire_scroll"
      },
      "minecraft:display_name":{
         "value":"Scroll of §cFlame Ward§r"
      },

      "minecraft:cooldown":{
          "category":"fire_ward",
          "duration": 55
      },
      "minecraft:can_destroy_in_creative": false,
         "minecraft:on_use":{
            "on_use":{
               "event":"fire"
            }
         }
      },
      "events":{
         "fire":{
            "sequence": [
              {
            "condition": "query.scoreboard('block_magic') == 1 && query.remaining_durability >= 0",
        "run_command": {
            "command": [
            "tellraw @s {\"rawtext\":[{\"text\":\"§8The Scroll's power is being blocked by an unknown force.\"}]}"
            ],
            "target": "holder"
              }
            },
             {
               "condition":"query.scoreboard('block_magic') == 0 && query.player_level >= 31 && query.scoreboard('fire') == 1",
               "randomize": [
                 {
                   "weight": 965,
                  "swing":{
                  },
                  "run_command": {
                    "command": [
                      "scoreboard players add @s fire_ward_spell 1",
                      "effect @s fire_resistance 45 0",
                      "playsound fire.ignite @a[r=5] ~~~ 7",
                      "tellraw @s {\"rawtext\":[{\"text\":\"§cYou now have the [Flame Ward] effect for 45 seconds.\"}]}"
                    ],
                    "target": "holder"
                   },
              		"decrement_stack": {}
                 },
                 {
                   "weight": 35,
                  "swing":{
                  },
                  "run_command": {
                    "command": [
                      "tellraw @s {\"rawtext\":[{\"text\":\"The Scroll backfired and you catch on fire!\"}]}"
                    ],
                    "target": "holder"
                  },
                  "damage": {
              			"type": "fire",
              			"amount": 8,
              			"target": "holder"
            		  },
              		"decrement_stack": {}
                 }
               ]
             },
            {
               "condition": "!query.scoreboard('fire') == 1",
               "run_command": {
                 "command": ["tellraw @s {\"rawtext\":[{\"text\":\"You do not have the required Knowledge to use this Scroll.\"}]}"],
                 "target": "holder"
               }
            },
            {
               "condition": "query.player_level < 31",
               "run_command": {
                 "command": ["tellraw @s {\"rawtext\":[{\"text\":\"Your Tier is too low to cast this Scroll.\"}]}"],
                 "target": "holder"
               }
            }
          ]
        }
      }
    }
  }